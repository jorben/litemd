{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/vmark/*"
      ],
      "@tauri-apps/api/core": [
        "./src/host/tauri/api-core.ts"
      ],
      "@tauri-apps/api/path": [
        "./src/host/tauri/api-path.ts"
      ],
      "@tauri-apps/api/webviewWindow": [
        "./src/host/tauri/api-webviewWindow.ts"
      ],
      "@tauri-apps/plugin-dialog": [
        "./src/host/tauri/plugin-dialog.ts"
      ],
      "@tauri-apps/plugin-fs": [
        "./src/host/tauri/plugin-fs.ts"
      ],
      "@tauri-apps/plugin-clipboard-manager": [
        "./src/host/tauri/plugin-clipboard-manager.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "vite.config.ts",
    "aliases.ts",
    "csp.ts"
  ],
  "exclude": [
    "src/vmark/**/*.test.ts",
    "src/vmark/**/__tests__/**"
  ]
}
